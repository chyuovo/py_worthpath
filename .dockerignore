# 根目录统一构建，仅发送必要源码与锁文件。
**
!Dockerfile
!.dockerignore
!backend/
!backend/pyproject.toml
!backend/uv.lock
!backend/app/
!backend/app/**
!backend/assets/
!backend/assets/**
!backend/alembic.ini
!backend/alembic/
!backend/alembic/**
!backend/scripts/
!backend/scripts/database.py
!backend/scripts/seed_icons.py
!backend/scripts/run.py
!frontend/
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/pnpm-workspace.yaml
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!frontend/scripts/
!frontend/scripts/generate-locales.cjs
**/__pycache__/
**/*.py[cod]
**/.env
**/.env.*
**/node_modules/
**/dist/
**/*.key
**/*.pem
