# 单镜像生产模板；复制为 backend/.env.docker，真实文件不要提交。
NODE_ENV=production
DATABASE_URL='mysql://USER:PASSWORD@host.docker.internal:3306/worthpath'
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
API_HOST=0.0.0.0
PORT=3100
API_ALLOWED_HOSTS=worthpath.chyuovo.top,127.0.0.1:3100
WEB_ORIGIN=https://worthpath.chyuovo.top
MCP_PUBLIC_URL=https://worthpath.chyuovo.top/mcp
MCP_WEB_URL=https://worthpath.chyuovo.top
MCP_ALLOWED_HOSTS=worthpath.chyuovo.top
MCP_ALLOWED_ORIGINS=https://worthpath.chyuovo.top
MCP_ALLOW_LOOPBACK_HOSTS=false
NETWORK_ALLOW_HTTP=false
NETWORK_ALLOW_HTTP_REDIRECTS=false
NETWORK_ALLOW_WILDCARD_ORIGINS=false
NETWORK_REQUIRE_SECURE_COOKIE=true
NETWORK_HSTS=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
NETWORK_RATE_LIMIT_ENABLED=true
NETWORK_RATE_LIMIT_WINDOW_MS=900000
NETWORK_AUTH_RATE_LIMIT_MAX=30
MCP_AUTH_RATE_LIMIT_MAX=100
ICON_STORAGE_DIR=/app/data/icons
WEB_DIST_DIR=/app/public
WORTHPATH_ENABLE_QUOTES=true
